# Neon PostgreSQL: copie a connection string completa de Connect > Postgres.
# Credencial privada: somente no servidor, nunca use prefixo VITE_.
DATABASE_URL=
# URL publica de Connect > Auth (termina em /auth).
NEON_AUTH_URL=
# Opcionais: use apenas se o projeto informar valores diferentes dos padroes.
NEON_AUTH_JWKS_URL=
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=
# Backup: chave Fernet privada. Guarde uma copia em local seguro.
BACKUP_KEY=
# Use 1 para executar pg_dump/pg_restore em Docker (PostgreSQL 18).
PG_USE_DOCKER=1
# Somente para restauracao manual em um banco vazio e separado.
RESTORE_DATABASE_URL=
